@using HRIS.Application.Features.Schedule.DTOs
@inject HttpClient Http
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">Schedule Calendar</div>
            <div class="card-body">
                <table class="table table-bordered text-center">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            @foreach (var day in WeekDays)
                            {
                                <th>@day</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Employees)
                        {
                            <tr>
                                <td>@emp.Username</td>
                                @foreach (var shift in emp.WeeklyShifts)
                                {
                                    <td class="shift-cell" @onclick="() => EditShift(emp, shift)">
                                        @shift
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>


@code {
    List<string> WeekDays = new()
    {
        "Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"
    };

    [Parameter] public string UserName { get; set; } = "lerjun";

    List<EmployeeScheduleVM> Employees = new();

    protected override async Task OnInitializedAsync()
    {
        var url = $"{AppConfig.ChatUrl}api/schedule/weekly";
        var response = await Http.GetFromJsonAsync<List<EmployeeScheduleDto>>(url);

        if (response != null)
        {
            Employees = response.Select(e => new EmployeeScheduleVM
            {
                UserId = e.UserId,
                Username= e.Username,
                WeeklyShifts = MapShifts(e.WeeklyShifts)
            }).ToList();
        }
    }

    private List<string> MapShifts(List<ShiftDto> shifts)
    {
        var ordered = Enum.GetValues<DayOfWeek>();

        return ordered.Select(day =>
        {
            var shift = shifts.FirstOrDefault(s => s.Day == day);

            if (shift == null)
                return "OFF";

            if (shift.TimeIn == "OFF")
                return "OFF";

            return $"{shift.TimeIn} - {shift.TimeOut}";
        }).ToList();
    }

    void EditShift(EmployeeScheduleVM emp, string shift)
    {
        Console.WriteLine($"Editing {emp.Username} - {shift}");
    }
    class EmployeeScheduleVM
    {
        public int UserId { get; set; }
        public string Username { get; set; }
        public List<string> WeeklyShifts { get; set; } = new();
    }

}