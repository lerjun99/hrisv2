@using System.Net.Http.Json
@using HRIS.Application.Features.Schedule.DTOs
@using HRIS.Application.Features.TimeEntries.DTOs
@inject HttpClient Http
@inject IJSRuntime JS
<style>
    /* Sticky last column */
    .sticky-column {
        position: sticky;
        right: 0;
        z-index: 2;
    }

        /* Optional: shadow for sticky column */
        .sticky-column::after {
            content: "";
            position: absolute;
            left: -1px;
            top: 0;
            width: 1px;
            height: 100%;
            background: rgba(0,0,0,0.1);
        }

    .container
    {
        max-width:100%;
    }

</style>
<div class="container">
    <div class="row mb-3">
        <div class="col-12">
            <p>Welcome, @UserName! Use the buttons below to log your times.</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-light border shadow-sm">
                <div class="d-flex flex-wrap gap-4 justify-content-between">
                    <div>
                        <strong>🕒 Work Time:</strong>
                        <span class="ms-2 text-success fw-semibold">
                            @FormatDurationHMS(RunningWorkDuration)
                        </span>
                    </div>

                    @if (RunningBreak1.HasValue)
                    {
                        <div>
                            <strong>☕ Morning Break:</strong>
                            <span class="ms-2 text-warning fw-semibold">
                                @FormatDurationHMS(RunningBreak1)
                            </span>
                        </div>
                    }

                    @if (RunningLunch.HasValue)
                    {
                        <div>
                            <strong>🍽️ Lunch:</strong>
                            <span class="ms-2 text-info fw-semibold">
                                @FormatDurationHMS(RunningLunch)
                            </span>
                        </div>
                    }

                    @if (RunningBreak3.HasValue)
                    {
                        <div>
                            <strong>🧃 Afternoon Break:</strong>
                            <span class="ms-2 text-secondary fw-semibold">
                                @FormatDurationHMS(RunningBreak3)
                            </span>
                        </div>
                    }
                    <div>
                        <strong>⏰ Late:</strong>
                        <span class="ms-2 text-danger fw-semibold">
                            @FormatDurationHMS(LateDuration)
                        </span>
                    </div>

                    <div>
                        <strong>☕ Over Break:</strong>
                        <span class="ms-2 text-warning fw-semibold">
                            @FormatDurationHMS(OverBreakDuration)
                        </span>
                    </div>

                    <div>
                        <strong>📉 Under Time:</strong>
                        <span class="ms-2 text-danger fw-semibold">
                            @FormatDurationHMS(UnderTimeDuration)
                        </span>
                    </div>

                    <div>
                        <strong>📊 Status:</strong>
                        <span class="ms-2 fw-bold
                        @(WorkStatus == "Completed" ? "text-success" :
                                                        WorkStatus == "Late" ? "text-danger" :
                                                        WorkStatus == "Under Time" ? "text-warning" :
                                                        "text-primary")">
                            @WorkStatus
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-4 justify-content-center">
        <!-- Clock In -->
        <div class="col-6 col-md-3">
            <button class="btn btn-primary w-100 h-100 d-flex align-items-center justify-content-center gap-2 shadow-sm"
                    @onclick="ClockIn"
                    disabled="@(CurrentEntry.ClockIn.HasValue)">
                <i class="bi bi-box-arrow-in-right fs-5"></i>
                <span>Clock In</span>
            </button>
        </div>

        <!-- Morning Break Start/End -->
        <div class="col-6 col-md-3">
            <button class="btn btn-outline-secondary w-100 h-100 d-flex align-items-center justify-content-center gap-2 shadow-sm"
                    @onclick="StartBreak1"
                    disabled="@(!CurrentEntry.ClockIn.HasValue || CurrentEntry.Break1In.HasValue)">
                <i class="bi bi-cup-hot fs-5"></i>
                <span>Start Morning Break</span>
            </button>
        </div>
        <div class="col-6 col-md-3">
            <button class="btn btn-outline-secondary w-100 h-100 d-flex align-items-center justify-content-center gap-2 shadow-sm"
                    @onclick="EndBreak1"
                    disabled="@(!CurrentEntry.Break1In.HasValue || CurrentEntry.Break1Out.HasValue)">
                <i class="bi bi-cup-hot-fill fs-5"></i>
                <span>End Morning Break</span>
            </button>
        </div>

        <!-- Lunch Start/End -->
        <div class="col-6 col-md-3">
            <button class="btn btn-outline-info w-100 h-100 d-flex align-items-center justify-content-center gap-2 shadow-sm"
                    @onclick="StartLunch"
                    disabled="@(!CurrentEntry.ClockIn.HasValue || CurrentEntry.LunchIn.HasValue)">
                <i class="bi bi-egg-fried fs-5"></i>
                <span>Start Lunch</span>
            </button>
        </div>
        <div class="col-6 col-md-3">
            <button class="btn btn-outline-info w-100 h-100 d-flex align-items-center justify-content-center gap-2 shadow-sm"
                    @onclick="EndLunch"
                    disabled="@(!CurrentEntry.LunchIn.HasValue || CurrentEntry.LunchOut.HasValue)">
                <i class="bi bi-egg-fill fs-5"></i>
                <span>End Lunch</span>
            </button>
        </div>

        <!-- Afternoon Break Start/End -->
        <div class="col-6 col-md-3">
            <button class="btn btn-outline-secondary w-100 h-100 d-flex align-items-center justify-content-center gap-2 shadow-sm"
                    @onclick="StartBreak3"
                    disabled="@(!CurrentEntry.ClockIn.HasValue || CurrentEntry.Break3In.HasValue)">
                <i class="bi bi-cup-straw fs-5"></i>
                <span>Start Afternoon Break</span>
            </button>
        </div>
        <div class="col-6 col-md-3">
            <button class="btn btn-outline-secondary w-100 h-100 d-flex align-items-center justify-content-center gap-2 shadow-sm"
                    @onclick="EndBreak3"
                    disabled="@(!CurrentEntry.Break3In.HasValue || CurrentEntry.Break3Out.HasValue)">
                <i class="bi bi-cup fs-5"></i>
                <span>End Afternoon Break</span>
            </button>
        </div>

        <!-- Clock Out -->
        <div class="col-6 col-md-3">
            <button class="btn btn-danger w-100 h-100 d-flex align-items-center justify-content-center gap-2 shadow-sm"
                    @onclick="ClockOut"
                    disabled="@(!CurrentEntry.ClockIn.HasValue || CurrentEntry.ClockOut.HasValue)">
                <i class="bi bi-box-arrow-right fs-5"></i>
                <span>Clock Out</span>
            </button>
        </div>
    </div>

    <!-- Time Log Table -->
    <div class="row">
        <div class="col-12">
            <h3>Your Time Log</h3>
            <div class="table-responsive" style="max-height:500px; overflow:auto;">
                <table class="table table-striped table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>User</th>
                            <th>Clock In</th>
                            <th>Morning Break In</th>
                            <th>Morning Break Out</th>
                            <th>Morning Break Duration</th>
                            <th>Lunch In</th>
                            <th>Lunch Out</th>
                            <th>Lunch Duration</th>
                            <th>Afternoon Break In</th>
                            <th>Afternoon Break Out</th>
                            <th>Afternoon Break Duration</th>
                            <th>Clock Out</th>
                            <th>Late</th>
                            <th>Over Break</th>
                            <th>Under Time</th>
                            <th>Status</th>
                            <th class="sticky-column bg-light">Total Work Duration</th> <!-- Sticky last column -->
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsTableLoading)
                        {
                            <tr>
                                <td colspan="17" class="text-center py-4">
                                    <div class="d-flex justify-content-center align-items-center gap-2">
                                        <span class="spinner-border spinner-border-sm text-primary"></span>
                                        <span class="fw-semibold">Loading time logs…</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (Entries.Any())
                        {
                            var grandTotal = Entries
                            .Where(e => e.TotalDuration.HasValue)
                            .Aggregate(TimeSpan.Zero, (sum, e) => sum + e.TotalDuration.Value);

                            var groupedByDate = Entries
                            .GroupBy(e => e.ClockIn?.Date)
                            .OrderByDescending(g => g.Key);

                            <!-- Grand total row -->
                            <tr class="table-info fw-bold">
                                <td colspan="16" style="text-align:start">Grand Total Hours</td>
                                <td class="sticky-column bg-light">@FormatDurationHMS(grandTotal)</td>
                            </tr>

                            foreach (var group in groupedByDate)
                            {
                                var collapseId = $"collapse-{group.Key:yyyyMMdd}";

                        <!-- Total per date -->
                        <tr class="table-secondary fw-bold text-start" style="cursor:pointer;" @onclick="@(() => ToggleCollapse(collapseId))">
                            <td colspan="16" style="text-align:start">
                                <i class="bi bi-chevron-right me-2 @(ExpandedGroups.Contains(collapseId) ? "rotate-90" : "")"></i>
                                Total Hours for @group.Key?.ToString("yyyy-MM-dd")
                            </td>
                            <td class="sticky-column bg-light">
                                @FormatDurationHMS(group.Where(e => e.TotalDuration.HasValue)
                                                                .Aggregate(TimeSpan.Zero, (sum, e) => sum + e.TotalDuration.Value))
                            </td>
                        </tr>

                        @foreach (var entry in group)
                                {
                                    <tr class="@(ExpandedGroups.Contains(collapseId) ? "" : "d-none")">
                                        <td>@entry.UserName</td>
                                        <td>@FormatTime(entry.ClockIn)</td>
                                        <td>@FormatTime(entry.Break1In)</td>
                                        <td>@FormatTime(entry.Break1Out)</td>
                                        <td>@FormatDurationHMS(entry.Break1Duration)</td>
                                        <td>@FormatTime(entry.LunchIn)</td>
                                        <td>@FormatTime(entry.LunchOut)</td>
                                        <td>@FormatDurationHMS(entry.LunchDuration)</td>
                                        <td>@FormatTime(entry.Break3In)</td>
                                        <td>@FormatTime(entry.Break3Out)</td>
                                        <td>@FormatDurationHMS(entry.Break3Duration)</td>
                                        <td>@FormatTime(entry.ClockOut)</td>
                                        <td class="text-danger">@FormatDurationHMS(CalculateLate(entry))</td>
                                        <td class="text-warning">@FormatDurationHMS(CalculateOverBreak(entry))</td>
                                        <td class="text-danger">@FormatDurationHMS(CalculateUnderTime(entry))</td>

                                        <td>
                                            @{
                                                var status = CalculateStatus(entry);
                                            }
                                            <span class="fw-bold
                                            @(status == "Completed" ? "text-success" :
                                              status == "Late" ? "text-danger" :
                                              status == "Under Time" ? "text-warning" : "text-primary")">
                                                @status
                                            </span>
                                        </td>

                                        <td class="sticky-column bg-light">@FormatDurationHMS(entry.TotalDuration)</td> <!-- Sticky last column -->
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="17" class="text-center">
                                    No entries yet. Start by clocking in!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

 </div>

@code {
    [Parameter] public string UserName { get; set; }
    [Parameter] public int UserId { get; set; }
    private bool IsTableLoading = false;
    private List<TimeEntryDto> Entries = new();
    private TimeEntryDto CurrentEntry = new();
    private System.Threading.Timer? _timer;
    private DateTime Now => DateTime.Now;
    private HashSet<string> ExpandedGroups = new();

    // // ---- SHIFT CONFIGURATION ----
    // private readonly TimeSpan ShiftStart = new(8, 0, 0);
    // private readonly TimeSpan ShiftEnd = new(17, 0, 0);

    private TimeSpan AllowedBreak1 => TimeSpan.FromMinutes(CurrentShift.BreakMinutes * 0.1667);
    private TimeSpan AllowedLunch => TimeSpan.FromMinutes(CurrentShift.BreakMinutes * 0.6667);
    private TimeSpan AllowedBreak3 => TimeSpan.FromMinutes(CurrentShift.BreakMinutes * 0.1667);
    private UserShiftDto? CurrentShift;
    private TimeSpan AllowedTotalBreak =>
    CurrentShift != null
        ? TimeSpan.FromMinutes(CurrentShift.BreakMinutes)
        : TimeSpan.Zero;
    private async Task LoadShift()
    {
        var url = $"{AppConfig.ChatUrl}api/schedule/user/{UserId}";
        var shift = await Http.GetFromJsonAsync<UserShiftDto>(url);
        CurrentShift = shift;
    }
    private void ToggleCollapse(string id)
    {
        if (ExpandedGroups.Contains(id))
            ExpandedGroups.Remove(id);
        else
            ExpandedGroups.Add(id);
    }
    private string GetCollapseClass(string id)
    {
        return ExpandedGroups.Contains(id) ? "" : "d-none";
    }
    protected override async Task OnInitializedAsync()
    {
        CurrentEntry.UserName = UserName;
        // await JS.InvokeVoidAsync("alert", $"Username: {UserId}");

        await LoadShift();
        await LoadActiveEntry();
        await LoadEntries();

        _timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }
    private TimeSpan CalculateLate(TimeEntryDto entry)
    {
        if (CurrentShift == null || !entry.ClockIn.HasValue)
            return TimeSpan.Zero;

        var shiftStartToday = entry.ClockIn.Value.Date + CurrentShift.TimeIn;

        if (entry.ClockIn.Value <= shiftStartToday + TimeSpan.FromMinutes(15)) // grace period
            return TimeSpan.Zero;

        return entry.ClockIn.Value - shiftStartToday;
    }

    private TimeSpan CalculateUnderTime(TimeEntryDto entry)
    {
        if (CurrentShift == null || !entry.ClockOut.HasValue)
            return TimeSpan.Zero;

        var shiftEndToday = entry.ClockOut.Value.Date + CurrentShift.TimeOut;

        if (entry.ClockOut.Value >= shiftEndToday)
            return TimeSpan.Zero;

        return shiftEndToday - entry.ClockOut.Value;
    }
    private string FormatTime(DateTime? dt)
    {
        return dt.HasValue ? dt.Value.ToString("h:mm tt") : "-"; // 8:00 AM / 6:00 PM
    }

    private string FormatDurationHMS(TimeSpan? ts)
    {
        return ts.HasValue ? $"{ts.Value.Hours}h {ts.Value.Minutes}m {ts.Value.Seconds}s" : "-"; // 0h 0m 2s
    }
    // ----------------- API Methods -----------------
    private async Task LoadActiveEntry()
    {
        var url = $"{AppConfig.ChatUrl}api/time-entries/active/{UserName}";

        var response = await Http.GetAsync(url);

        if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
        {
            CurrentEntry = new TimeEntryDto { UserName = UserName };
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            CurrentEntry = new TimeEntryDto { UserName = UserName };
            return;
        }

        var entry = await response.Content.ReadFromJsonAsync<TimeEntryDto>();

        CurrentEntry = entry ?? new TimeEntryDto { UserName = UserName };
    }
    private async Task ClockIn()
    {
        var response = await Http.PostAsync($"{AppConfig.ChatUrl}api/time-entries/clock-in?UserId={UserId}&userName={UserName}", null);
        if (response.IsSuccessStatusCode)
        {
            await LoadActiveEntry();
            await LoadEntries();
            StateHasChanged();
        }
    }

    private async Task StartBreak1()
    {
        var response = await Http.PostAsync($"{AppConfig.ChatUrl}api/time-entries/start-break?userName={UserName}&UserId={UserId}&type=Morning", null);
        if (response.IsSuccessStatusCode)
        {
            CurrentEntry.Break1In = DateTime.Now;
            await LoadEntries();
            StateHasChanged();
        }
    }

    private async Task EndBreak1()
    {
        var response = await Http.PostAsync($"{AppConfig.ChatUrl}api/time-entries/end-break?userName={UserName}&UserId={UserId}&type=Morning", null);
        if (response.IsSuccessStatusCode)
        {
            CurrentEntry.Break1Out = DateTime.Now;
            await LoadEntries();
            StateHasChanged();
        }
    }

    private async Task StartLunch()
    {
        var response = await Http.PostAsync($"{AppConfig.ChatUrl}api/time-entries/start-break?userName={UserName}&UserId={UserId}&type=Lunch", null);
        if (response.IsSuccessStatusCode)
        {
            CurrentEntry.LunchIn = DateTime.Now;
            await LoadEntries();
            StateHasChanged();
        }
    }

    private async Task EndLunch()
    {
        var response = await Http.PostAsync($"{AppConfig.ChatUrl}api/time-entries/end-break?userName={UserName}&UserId={UserId}&type=Lunch", null);
        if (response.IsSuccessStatusCode)
        {
            CurrentEntry.LunchOut = DateTime.Now;
            await LoadEntries();
            StateHasChanged();
        }
    }

    private async Task StartBreak3()
    {
        var response = await Http.PostAsync($"{AppConfig.ChatUrl}api/time-entries/start-break?userName={UserName}&UserId={UserId}&type=Afternoon", null);
        if (response.IsSuccessStatusCode)
        {
            CurrentEntry.Break3In = DateTime.Now;
            await LoadEntries();
            StateHasChanged();
        }
    }

    private async Task EndBreak3()
    {
        var response = await Http.PostAsync($"{AppConfig.ChatUrl}api/time-entries/end-break?userName={UserName}&UserId={UserId}&type=Afternoon", null);
        if (response.IsSuccessStatusCode)
        {
            CurrentEntry.Break3Out = DateTime.Now;
            await LoadEntries();
            StateHasChanged();
        }
    }

    private async Task ClockOut()
    {
        var response = await Http.PostAsync($"{AppConfig.ChatUrl}api/time-entries/clock-out?userName={UserName}&UserId={UserId}", null);
        if (response.IsSuccessStatusCode)
        {
            CurrentEntry.ClockOut = DateTime.Now;
            await LoadEntries();
            CurrentEntry = new TimeEntryDto { UserName = UserName };
            await LoadEntries();
            StateHasChanged();
        }
    }

    private async Task LoadEntries()
    {
        try
        {
            IsTableLoading = true;
            string url = $"{AppConfig.ChatUrl}api/time-entries/getLogs?UserId={UserId}";
            //string url = "http://localhost:5196/api/time-entries/lerjun";
            var data = await Http.GetFromJsonAsync<List<TimeEntryDto>>(url);
            Entries = data ?? new List<TimeEntryDto>();
       
        }
        finally
        {
            IsTableLoading = false;
            StateHasChanged();
        }
    }
    private TimeSpan? LateDuration
    {
        get
        {
            if (!CurrentEntry.ClockIn.HasValue)
                return null;

            var shiftStartToday = CurrentEntry.ClockIn.Value.Date + CurrentShift.TimeIn;

            if (CurrentEntry.ClockIn.Value <= shiftStartToday)
                return TimeSpan.Zero;

            return CurrentEntry.ClockIn.Value - shiftStartToday;
        }
    }
    private TimeSpan TotalActualBreak
    {
        get
        {
            TimeSpan total = TimeSpan.Zero;

            if (CurrentEntry.Break1Duration.HasValue)
                total += CurrentEntry.Break1Duration.Value;

            if (CurrentEntry.LunchDuration.HasValue)
                total += CurrentEntry.LunchDuration.Value;

            if (CurrentEntry.Break3Duration.HasValue)
                total += CurrentEntry.Break3Duration.Value;

            return total;
        }
    }
    private TimeSpan? OverBreakDuration
    {
        get
        {
            if (CurrentShift == null)
                return TimeSpan.Zero;

            var over = TotalActualBreak - AllowedTotalBreak;

            return over > TimeSpan.Zero ? over : TimeSpan.Zero;
        }
    }
    private TimeSpan? UnderTimeDuration
    {
        get
        {
            if (!CurrentEntry.ClockOut.HasValue)
                return null;

            var shiftEndToday = CurrentEntry.ClockOut.Value.Date + CurrentShift.TimeOut;

            if (CurrentEntry.ClockOut.Value >= shiftEndToday)
                return TimeSpan.Zero;

            return shiftEndToday - CurrentEntry.ClockOut.Value;
        }
    }
    private string WorkStatus
    {
        get
        {
            if (!CurrentEntry.ClockIn.HasValue)
                return "Not Started";

            if (CurrentEntry.ClockIn.HasValue && !CurrentEntry.ClockOut.HasValue)
                return "Working";

            if (LateDuration > TimeSpan.Zero)
                return "Late";

            if (UnderTimeDuration > TimeSpan.Zero)
                return "Under Time";

            return "Completed";
        }
    }

    private TimeSpan CalculateOverBreak(TimeEntryDto entry)
    {
        TimeSpan over = TimeSpan.Zero;

        if (entry.Break1Duration.HasValue && entry.Break1Duration > AllowedBreak1)
            over += entry.Break1Duration.Value - AllowedBreak1;

        if (entry.LunchDuration.HasValue && entry.LunchDuration > AllowedLunch)
            over += entry.LunchDuration.Value - AllowedLunch;

        if (entry.Break3Duration.HasValue && entry.Break3Duration > AllowedBreak3)
            over += entry.Break3Duration.Value - AllowedBreak3;

        return over;
    }

    private string CalculateStatus(TimeEntryDto entry)
    {
        if (!entry.ClockIn.HasValue)
            return "Not Started";

        if (entry.ClockIn.HasValue && !entry.ClockOut.HasValue)
            return "Working";

        if (CalculateLate(entry) > TimeSpan.Zero)
            return "Late";

        if (CalculateUnderTime(entry) > TimeSpan.Zero)
            return "Under Time";

        return "Completed";
    }
    // ----------------- Utility -----------------
    private string FormatDate(DateTime? dt) => dt.HasValue ? dt.Value.ToString("HH:mm:ss") : "-";
    private string FormatDuration(TimeSpan? ts) => ts.HasValue ? $"{ts.Value.Hours}h {ts.Value.Minutes}m {ts.Value.Seconds}s" : "-";

    private TimeSpan? RunningWorkDuration
    {
        get
        {
            if (!CurrentEntry.ClockIn.HasValue) return null;

            // Use ClockOut if exists, otherwise current PH time
            var end = CurrentEntry.ClockOut ?? Now;

            var total = end - CurrentEntry.ClockIn.Value;

            if (CurrentEntry.Break1In.HasValue)
                total -= (CurrentEntry.Break1Out ?? Now) - CurrentEntry.Break1In.Value;

            if (CurrentEntry.LunchIn.HasValue)
                total -= (CurrentEntry.LunchOut ?? Now) - CurrentEntry.LunchIn.Value;

            if (CurrentEntry.Break3In.HasValue)
                total -= (CurrentEntry.Break3Out ?? Now) - CurrentEntry.Break3In.Value;

            // Ensure total is never negative
            return total < TimeSpan.Zero ? TimeSpan.Zero : total;
        }
    }

    private TimeSpan? RunningBreak1 =>
        CurrentEntry.Break1In.HasValue && !CurrentEntry.Break1Out.HasValue
            ? Now - CurrentEntry.Break1In.Value
            : null;

    private TimeSpan? RunningLunch =>
        CurrentEntry.LunchIn.HasValue && !CurrentEntry.LunchOut.HasValue
            ? Now - CurrentEntry.LunchIn.Value
            : null;

    private TimeSpan? RunningBreak3 =>
        CurrentEntry.Break3In.HasValue && !CurrentEntry.Break3Out.HasValue
            ? Now - CurrentEntry.Break3In.Value
            : null;


    // ----------------- TimeEntry DTO -----------------
   
}

